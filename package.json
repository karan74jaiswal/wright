{
  "name": "wright",
  "version": "1.0.0",
  "scripts": {
    "dev:cli": "cd packages/cli && bun run dev",
    "dev:session": "cd packages/session-service && bun run dev",
    "dev:chat": "cd packages/chat-service && bun run dev",
    "dev:gateway": "cd packages/api-gateway && bun run dev",
    "dev:worker": "cd packages/worker-service && bun run dev",
    "dev:backend": "WORKSPACE_ROOT=$(pwd) bun run dev:session & WORKSPACE_ROOT=$(pwd) bun run dev:chat & WORKSPACE_ROOT=$(pwd) bun run dev:gateway & WORKSPACE_ROOT=$(pwd) bun run dev:worker"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "intent": {
    "skills": [
      "@tanstack/query",
      "@trpc/server",
      "@trpc/client"
    ]
  }
}
