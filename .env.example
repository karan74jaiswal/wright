# Database
DATABASE_URL=postgresql://user:password@localhost:5432/wright?sslmode=require

# Service Ports (defaults shown)
GATEWAY_PORT=3000
SESSION_SERVICE_PORT=3001
CHAT_SERVICE_PORT=3002

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Provider API Keys
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LangSmith (optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="Wright"

# Sentry (optional)
SENTRY_DSN=

# Node
NODE_ENV=development

# Clerk Credentials
CLERK_OAUTH_CLIENT_SECRET=
CLERK_OAUTH_CLIENT_ID=
CLERK_FRONTEND_API=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
JWT_SECRET= # MUST BE A HIGH ENTROPY STRING TO SECURE MICROSERVICES