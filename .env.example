# Database
DATABASE_URL=postgresql://user:password@localhost:5432/wright?sslmode=require

# Service Ports (defaults shown)
GATEWAY_PORT=3000
SESSION_SERVICE_PORT=3001
CHAT_SERVICE_PORT=3002

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Provider API Keys
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LangSmith (optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="Wright"

# Sentry (optional)
SENTRY_DSN=

# Node
NODE_ENV=development